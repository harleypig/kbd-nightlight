<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Backlight level at the lock and login screen: off, low or high. -->
    <add key="LockLevel" value="high" />
    <!-- Backlight level set once when you unlock or log on: off, low or high. -->
    <add key="UnlockLevel" value="low" />
    <!-- While locked, how often to re-apply the lock level, in seconds (minimum 5). -->
    <add key="IntervalSeconds" value="30" />
  </appSettings>
</configuration>
